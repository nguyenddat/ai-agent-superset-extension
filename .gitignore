# Local environment and credentials
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Python caches and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/

# Node dependencies
node_modules/
**/node_modules/
/extensions/text-to-bi/dist/
/extensions/text-to-bi/frontend/dist/

# Local browser/debug artifacts and editor settings
.playwright-mcp/
.vscode/

# Local databases, logs, and OS files
*.db
*.sqlite
*.sqlite3
*.log
*.supx
*.provenance.json
.release-backups/
.DS_Store

# Airflow runtime logs
/simulation/airflow/logs/*
!/simulation/airflow/logs/.gitkeep

# Dot-prefixed files and directories (local tool state such as .team/ or .uv-cache/),
# except the dotfiles the repository keeps
.*
!.gitignore
!.gitkeep
!.npmrc
!.env.example
